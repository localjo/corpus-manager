# Vault mounting
VAULT_ROOT=/data/vault
CLAUDE_MD_PATH=/data/vault/CLAUDE.md
HOST_VAULT_PATH=./vault
HOST_VAULTS_PATH=./vaults
HOST_CORPUS_REGISTRY_PATH=./corpus-registry.yaml
CORPUS_REGISTRY_PATH=/data/corpus-registry.yaml
HOST_SYNCTHING_CONFIG_PATH=./syncthing-config

# Anthropic
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_QUERY_MODEL=claude-sonnet-4-5
# Optional: model used by ingest/deprecate agent loops. Defaults to ANTHROPIC_MODEL.
ANTHROPIC_INGEST_MODEL=claude-opus-4-7
# Optional: ingest agent loop budgets.
INGEST_LOOP_MAX_TURNS=35
INGEST_LOOP_MAX_TOKENS=8192

# Orchestrator MCP HTTP endpoint
HOST=0.0.0.0
PORT=8765
MCP_PATH=/mcp

# Public auth token expected by reverse proxy/header gate
MCP_BEARER_TOKEN=replace-me
